/* ========================================
   共享空间公共样式
   ======================================== */

/* --- Design Tokens --- */
page {
    /* Brand  → 门店主题色 */
    --main-color: #47BA91;
    --main-color-light: #E8F7F2;
    --main-color-shadow: #3AA982;
    --main-green: #7FD6B8;
    --main-gradient: linear-gradient(135deg, #47BA91, #7FD6B8);

    /* Semantic */
    --main-red: #F8525E;
    --main-blue: #5abdff;
    --main-gray: #a4a4a4;
    --main-orange: #FF8A4D;

    /* Text */
    --text-primary: #1A1A1A;
    --text-secondary: #666666;
    --text-tertiary: #999999;
    --text-price: #1A1A1A;

    /* Background */
    --bg-page: #FFF7F2;
    --bg-card: #FFFFFF;
    --bg-section: #F5F7F6;

    /* Border */
    --border-light: #EEEEEE;
    --border-medium: #E0E0E0;

    /* Radius */
    --radius-sm: 12rpx;
    --radius-md: 20rpx;
    --radius-lg: 28rpx;
    --radius-xl: 36rpx;
    --radius-full: 999rpx;

    /* Spacing */
    --spacing-xs: 12rpx;
    --spacing-sm: 20rpx;
    --spacing-md: 30rpx;
    --spacing-lg: 40rpx;

    /* Shadows */
    --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
    --shadow-elevated: 0 8rpx 32rpx rgba(0, 0, 0, 0.10);
    --shadow-button: 0 6rpx 20rpx rgba(71, 186, 145, 0.25);
}

/* --- Theme Utility Classes --- */
.theme-bg-primary {
    background: var(--main-color) !important;
}

.theme-color-primary {
    color: var(--main-color) !important;
}

.theme-color-shadow {
    box-shadow: var(--main-color-shadow) 0rpx 0rpx 30rpx;
}

/* --- Card --- */
.card {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
}

.card-padding {
    padding: var(--spacing-md);
}

/* --- Buttons --- */
.btn-primary {
    background: var(--main-gradient);
    color: #fff;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-button);
    border: none;
    font-weight: 500;
}

.btn-outline {
    border: 2rpx solid var(--main-color);
    color: var(--main-color);
    border-radius: var(--radius-full);
    background: transparent;
}

/* --- Text --- */
.text-primary {
    color: var(--text-primary);
}

.text-secondary {
    color: var(--text-secondary);
}

.text-tertiary {
    color: var(--text-tertiary);
}

.text-price {
    color: var(--text-price);
    font-weight: 600;
}

.text-ellipsis {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.text-ellipsis-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* --- Layout --- */
.flex {
    display: flex;
}

.flex-center {
    display: flex;
    align-items: center;
    justify-content: center;
}

.flex-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.flex-col {
    display: flex;
    flex-direction: column;
}

/* --- Divider --- */
.divider {
    height: 1rpx;
    background: var(--border-light);
}

/* --- Tag / Pill --- */
.tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 4rpx 16rpx;
    border-radius: var(--radius-full);
    font-size: 22rpx;
    background: var(--main-color-light);
    color: var(--main-color);
}

/* --- Animations --- */
.fade-in {
    animation: fadeIn 0.3s ease;
}

.slide-up {
    animation: slideUp 0.3s ease;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideUp {
    from { opacity: 0; transform: translateY(40rpx); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes shimmer {
    0% { background-position: -600rpx 0; }
    100% { background-position: 600rpx 0; }
}

/* --- Skeleton Base --- */
.skeleton-item {
    background: linear-gradient(90deg, #F0F0F0 25%, #E8E8E8 37%, #F0F0F0 63%);
    background-size: 600rpx 100%;
    animation: shimmer 1.5s ease infinite;
    border-radius: var(--radius-sm);
}
