/**index.wxss**/
page {
  width: 100%;
  height: 100%;
}

.container {
  margin-top: 10rpx;
}

/* 头部搜索框 */
.top {
  width: 100%;
  background-size: cover;
  background: linear-gradient(180deg, var(--main-color) 0%, var(--main-color) 60%, var(--bg-page) 100%);
}

.top .banner {
  height: 206rpx;
  background: transparent;
}

.top-search {
  display: flex;
  justify-content: center;
  padding-bottom: 24rpx;
}

.top-search .left {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  width: 600rpx;
  margin-right: 20rpx;
  display: flex;
  height: 68rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.top-search .label {
  width: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: nowrap;
  border-right: 1rpx solid #eee;
}

.top-search .label image {
  width: 25rpx;
  height: 25rpx;
  margin-right: 6rpx;
}

.top-search .label text {
  font-size: 26rpx;
  display: block;
  max-width: 240rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 6rpx;
  color: var(--text-primary);
}

.top-search .label icon {
  width: 0;
  height: 0;
  border-top: 10rpx solid var(--main-color);
  border-right: 10rpx solid transparent;
  border-left: 10rpx solid transparent;
}

.top-search .input {
  padding: 0 20rpx;
  flex: 1;
  font-size: 26rpx;
}

.top-search .right {
  margin-top: 20rpx;
  color: #fff;
  text-align: center;
  width: 90rpx;
}

.top-search .right text {
  display: block;
  font-size: 24rpx;
}

.banner {
  height: 400rpx;
  width: 100%;
  overflow: hidden;
  margin-bottom: 10rpx;
  text-align: center;
}

.banner swiper {
  height: 100%;
  width: 100%;
}

.banner image {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

/* 门店卡片 */
.store-card {
  height: 300rpx;
  background-color: #fff;
  border-radius: var(--radius-md);
  margin: 0 15rpx;
  display: flex;
  flex-direction: row;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.store-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-elevated);
}

.store-card__image {
  width: 200rpx;
  height: 260rpx;
  margin: 20rpx;
  border-radius: var(--radius-sm);
}

.text-container {
  width: 100%;
  position: relative;
  padding-right: 16rpx;
}

/* 空闲标签 - 药丸样式 */
.free-tag {
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
  position: absolute;
  top: 15rpx;
  width: auto;
  padding: 0 16rpx;
  height: 42rpx;
  right: 10rpx;
  background-color: var(--main-color-light);
  color: var(--main-color);
  border-radius: var(--radius-full);
  font-weight: 500;
}

.free-tag text {
  font-weight: 600;
  font-size: 26rpx;
  margin-left: 4rpx;
}

.text-container .name {
  width: 320rpx;
  height: 120rpx;
  margin-top: 15rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5em;
  color: var(--text-primary);
}

.text-container .address {
  font-size: 23rpx;
  margin-top: 8rpx;
  color: var(--text-secondary);
  height: 70rpx;
  margin-right: 4rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.6;
}

.text-container .item-buttom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.text-container .item-buttom .info {
  display: flex;
}

.text-container .item-buttom .info .position {
  font-size: 22rpx;
  line-height: 40rpx;
  display: flex;
  text-align: center;
  margin: auto;
  padding: 0rpx 14rpx;
  border-radius: var(--radius-full);
  width: fit-content;
  color: var(--main-color);
  background: var(--main-color-light);
  border: none;
}

/* 立即预定按钮 */
.text-container .item-buttom .door-button {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0rpx 28rpx;
  font-size: 26rpx;
  margin-right: 10rpx;
  color: #fff;
  border-radius: var(--radius-full);
  background: var(--main-gradient);
  box-shadow: var(--shadow-button);
  font-weight: 500;
}

/* 空状态 */
.noStoreInfo {
  font-size: 30rpx;
  text-align: center;
  margin: 100rpx;
  color: var(--text-tertiary);
}

.noStoreInfo .noStore-image {
  height: 220rpx;
  width: 220rpx;
  opacity: 0.7;
}

.noStoreInfo .go-near {
  font-size: 32rpx;
  width: 360rpx;
  height: 84rpx;
  color: #fff;
  border-radius: var(--radius-full);
  background: var(--main-gradient);
  box-shadow: var(--shadow-button);
  margin-top: 50rpx;
  font-weight: 500;
}

.bt {
  height: 100rpx;
  margin-bottom: 50rpx;
}
