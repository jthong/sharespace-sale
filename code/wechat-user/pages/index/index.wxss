/* pages/doorList/doorList.wxss */
/* 门店模板：棋牌-模板1 (template_key=qipai-1) */
@import "qipai1.wxss";
page {
  height: 100%;
  width: 100%;
  background-color: var(--bg-page);
  background-image: repeating-linear-gradient(
    45deg,
    rgba(71, 186, 145, 0.03) 0px,
    rgba(71, 186, 145, 0.03) 16px,
    transparent 16px,
    transparent 32px
  );
}

/* 样式修改 */
.logo-top {
  background: var(--main-gradient);
  z-index: 1;
}

.logo-top .name {
  color: #FFFFFF;
  font-weight: 600;
  font-size: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.simple .controller {
  background: var(--main-gradient);
  height: 200rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  font-size: 26rpx;
  color: #fff;
}

.simple .controller .item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  height: 130rpx;
  justify-content: space-around;
  transition: background 0.15s;
}

.simple .controller .item:active {
  background: rgba(0, 0, 0, 0.1);
}

.simple .controller .item image {
  width: 68rpx;
  height: 68rpx;
}

.info-card {
  background: var(--bg-card);
  padding: 24rpx 30rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin: 20rpx 24rpx;
}

.info-card .top {
  display: flex;
  justify-content: space-between;
}

.info-card .top .left {
  display: flex;
  justify-content: space-between;
}

.info-card .top .left .info {
  display: flex;
  justify-content: space-between;
}

.info-card .top .left .info .name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  font-style: normal;
  width: 500rpx;
  margin-left: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.info-card .distant {
  display: flex;
  align-items: center;
  width: fit-content;
  height: 44rpx;
  background: var(--main-color-light);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  padding: 0 16rpx;
}

.info-card .top .left .iconfont {
  margin: auto;
}

.info-card .top .left .show-img {
  width: 118rpx;
  height: 118rpx;
  margin-right: 26rpx;
}

.change-btn {
  width: 169rpx;
  height: 52rpx;
  background: var(--main-gradient);
  border-radius: var(--radius-full);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 22rpx;
  color: #fff;
  box-shadow: var(--shadow-button);
}

.change-btn image {
  width: 22rpx;
  height: 20rpx;
  margin-right: 8rpx;
}

.info-card .location {
  width: 450rpx;
  font-weight: 300;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 36rpx;
  margin-top: 8rpx;
}

.info-card .bottom {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.info-card .bottom .line {
  width: 0rpx;
  height: 34rpx;
  border: 0.5rpx solid var(--border-light);
  margin-top: 22rpx;
}

.info-card .bottom image {
  width: 39rpx;
  height: 39rpx;
}

.info-card .bottom .item {
  display: flex;
  margin-top: 20rpx;
  flex-direction: column;
  align-items: center;
  font-weight: 400;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.popup {
  width: 539rpx;
  background: linear-gradient(180deg, #E0F5ED 0%, #FFFFFF 100%);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 20rpx;
}

.popup .title {
  font-weight: 600;
  font-size: 34rpx;
  color: var(--text-primary);
  text-align: center;
  margin-top: 33rpx;
}

.popup .sub-title {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  margin-top: 13rpx;
  margin-bottom: 20rpx;
}

.popup .btn {
  width: 399rpx;
  height: 82rpx;
  background: var(--main-gradient);
  border-radius: var(--radius-full);
  font-size: 30rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-button);
}

.popup image {
  width: 44rpx;
  height: 44rpx;
  margin-left: 63rpx;
  margin-right: 34rpx;
}

.lists .item {
  padding: 24rpx 30rpx;
  width: 690rpx;
  border-radius: var(--radius-md);
  margin: 20rpx auto;
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.item:last-of-type {
  margin-bottom: 10rpx;
}

.lists .item:last-child {
  margin-bottom: 10rpx;
}

.lists .item .top {
  display: flex;
  justify-content: space-between;
}

.lists .item .top .left {
  width: 200rpx;
  height: 260rpx;
  border-radius: var(--radius-sm);
  position: relative;
  overflow: hidden;
  margin-right: 24rpx;
}

.lists .item .top .left .img {
  width: 200rpx;
  height: 250rpx;
}

.lists .item .top .left .flag {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
}

.lists .item .top .left .doing {
  background: #FF8A4D;
}

.lists .item .top .left .undo {
  background: var(--main-color);
}

.lists .item .top .left .disabled {
  background: var(--text-tertiary);
}

.lists .item .top .left .daiqingjie {
  background: #7FD6B8;
}

.lists .item .top .left .bukeyong {
  background: #FF8A4D;
}

.lists .item .top .right {
  width: 440rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.lists .item .top .right .name {
  font-weight: 700;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  color: var(--text-primary);
}

.lists .item .top .right .name .type {
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--main-gradient);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  margin-right: 8rpx;
  white-space: nowrap;
}

.lists .item .top .right .tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.lists .item .top .right .tags .tag {
  margin: 0 10rpx 10rpx 0;
  background: var(--main-color-light);
  border-radius: var(--radius-full);
  padding: 4rpx 14rpx;
  color: var(--main-color);
  font-size: 22rpx;
  line-height: 28rpx;
}

.lists .item .top .right .line2 {
  display: flex;
  justify-content: space-between;
}

.lists .item .top .right .line2.bt {
  display: flex;
  justify-content: flex-end;
  height: 50rpx;
  line-height: 50rpx;
}

.line3 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #FF8A4D;
}

.line3 .time-line {
  display: flex;
  justify-content: center;
  align-items: center;
}

.line3 .time-line image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 12rpx;
}

.line3 .more {
  color: var(--main-color);
  font-size: 21rpx;
  display: flex;
  align-items: center;
  margin-left: 10rpx;
  /* margin-right: -20rpx; */
}

.line3 .more icon {
  margin-top: -12rpx;
}

.priceLabel {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.lists .item .top .right .priceLabel .price {
  font-weight: 700;
  font-size: 17rpx;
  line-height: 32rpx;
}

.lists .item .top .right .priceLabel .price .color-attention {
  font-weight: 700;
  font-size: 31rpx;
  line-height: 32rpx;
  color: var(--text-price);
}

.lists .item .top .right .bottom {
  display: flex;
  justify-content: right;
  align-items: center;
}

.lists .item .top .right .bottom .btn {
  width: 130rpx;
  height: 54rpx;
  text-align: center;
  line-height: 54rpx;
  border-radius: var(--radius-full);
  margin: 10rpx;
  font-size: 26rpx;
  background: var(--main-gradient);
  color: #fff;
  box-shadow: var(--shadow-button);
}

.lists .item .top .right .bottom .disabled {
  background: var(--text-tertiary);
  color: #fff;
  box-shadow: none;
}

.lists .item .foot {
  margin-top: 10rpx;
}

.lists .item .foot .foot-top {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.lists .item .foot .foot-top .labels {
  display: flex;
}

.lists .item .foot .foot-top .label::before {
  content: "";
  display: inline-block;
  margin-right: 6rpx;
  width: 20rpx;
  height: 20rpx;
  background: #e8e8e8;
}

.lists .item .foot .foot-top .label {
  margin-right: 20rpx;
}

.lists .item .foot .foot-top .disabled::before {
  background: var(--main-color);
}

.lists .item .foot .times {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
}

.lists .item .foot .times .time {
  font-size: 20rpx;
  text-align: center;
  color: #aaa;
  border-top: 10rpx solid #e8e8e8;
  width: 24rpx;
  line-height: 30rpx;
}

.lists .item .foot .times .disabled {
  border-color: var(--main-color);
}

.simple .top-tabs-container {
  padding: 0 20rpx 20rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-between;
}

.simple .top-tabs {
  width: 100%;
  display: flex;
  background-color: #fff;
  /* justify-content: space-between; */
}
.simple .top-tabs .tab {
  margin-left: 10rpx;
}
.simple .top-tabs.active {
  color: var(--main-color);
  font-weight: bold;
  /* box-shadow: 0rpx 5rpx 5rpx 5rpx var(--main-color); */
  background-image: linear-gradient(181.2deg, #fff, var(--main-color) 150.8%);
}

.simple .top-tabs {
  width: 49.6%;
  height: 80rpx;
  font-size: 32rpx;
  line-height: 60rpx;
  text-align: center;
  align-items: center;
  background-color: var(--bg-section);
  border-radius: var(--radius-sm);
  padding: 10rpx 10rpx;
  margin: 0rpx 10rpx;
}


.notes {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 30rpx;
  padding-bottom: 140rpx;
}

.notes image {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

/* 样式修改结束 */
