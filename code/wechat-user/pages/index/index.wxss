/* ==================== 雀小仙风格单店首页 ==================== */
.qxx-page{background:var(--bg-page);min-height:100vh;padding-bottom:40rpx;box-sizing:border-box;}
.qxx-header{position:relative;display:flex;flex-direction:row;align-items:center;justify-content:center;padding:82rpx 40rpx 36rpx;background:var(--main-gradient);border-radius:0 0 36rpx 36rpx;}
.qxx-logo{position:absolute;left:40rpx;top:50%;transform:translateY(-50%);width:112rpx;height:112rpx;border-radius:24rpx;background:#fff;display:flex;align-items:center;justify-content:center;color:#286654;font-size:44rpx;font-weight:700;box-shadow:0 8rpx 24rpx rgba(0,0,0,.12);}
.qxx-brand{text-align:center;}
.qxx-name{font-size:46rpx;font-weight:700;color:#fff;letter-spacing:8rpx;}

.qxx-search{margin:24rpx 32rpx 0;}
.qxx-search-bar{display:flex;align-items:center;background:#fff;border-radius:44rpx;padding:20rpx 28rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04);}
.qxx-search-icon{width:32rpx;height:32rpx;margin-right:16rpx;}
.qxx-search-input{flex:1;font-size:28rpx;}
.qxx-search-ph{color:#B0B4BB;}
.qxx-search-clear{width:36rpx;height:36rpx;line-height:36rpx;text-align:center;background:#E8EAED;color:#8A8F98;border-radius:50%;font-size:22rpx;}

.qxx-actions{display:flex;margin:24rpx 32rpx 0;}
.qxx-action{flex:1;display:flex;align-items:center;justify-content:center;height:92rpx;border-radius:20rpx;font-size:30rpx;font-weight:600;margin:0 10rpx;}
.qxx-action:first-child{background:#fff;color:var(--main-color);box-shadow:0 4rpx 16rpx rgba(0,0,0,.05);}
.qxx-action:last-child{background:var(--main-gradient);color:#fff;box-shadow:0 8rpx 20rpx rgba(71,186,145,.28);}
.qxx-action-icon{width:40rpx;height:40rpx;margin-right:12rpx;}

.qxx-store{display:flex;align-items:center;background:#fff;border-radius:24rpx;margin:24rpx 32rpx 0;padding:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04);}
.qxx-store-img{width:176rpx;height:176rpx;border-radius:16rpx;flex-shrink:0;}
.qxx-store-placeholder{display:flex;align-items:center;justify-content:center;background:#e7f5ef;color:#286654;font-size:46rpx;font-weight:700;}
.qxx-store-info{margin-left:24rpx;flex:1;min-width:0;}
.qxx-store-top{display:flex;align-items:center;justify-content:space-between;}
.qxx-store-name{font-size:30rpx;font-weight:700;color:#1A1A1A;}
.qxx-store-dist{font-size:22rpx;color:var(--main-color);background:rgba(71,186,145,.1);padding:4rpx 14rpx;border-radius:20rpx;}
.qxx-store-addr{font-size:22rpx;color:#8A8F98;margin-top:10rpx;line-height:1.5;}
.qxx-store-btns{display:flex;margin-top:16rpx;}
.qxx-sbtn{flex:1;display:flex;align-items:center;justify-content:center;height:64rpx;border-radius:14rpx;background:#F4F5F7;font-size:24rpx;color:#3A3D42;margin-right:12rpx;}
.qxx-sbtn:last-child{margin-right:0;}
.qxx-sbtn-icon{width:28rpx;height:28rpx;margin-right:8rpx;}
.qxx-sbtn-primary{background:var(--main-gradient);color:#fff;font-weight:600;}

.qxx-grid{display:flex;flex-wrap:wrap;background:#fff;border-radius:24rpx;margin:24rpx 32rpx 0;padding:28rpx 12rpx 8rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04);}
.qxx-gitem{width:25%;display:flex;flex-direction:column;align-items:center;margin-bottom:28rpx;}
.qxx-gicon{width:76rpx;height:76rpx;}
.qxx-gitem text{font-size:24rpx;color:#3A3D42;margin-top:10rpx;}

.qxx-legend{display:flex;margin:28rpx 32rpx 0;padding:0 8rpx;}
.qxx-li{display:flex;align-items:center;font-size:24rpx;color:#6B7078;margin-right:36rpx;}
.qxx-dot{width:18rpx;height:18rpx;border-radius:50%;margin-right:10rpx;}
.qxx-dot-red{background:#FF8A4D;}
.qxx-dot-green{background:#47BA91;}

.qxx-rooms{margin:20rpx 32rpx 0;}
.qxx-room{background:#fff;border-radius:24rpx;padding:30rpx 32rpx;margin-bottom:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04);}
.qxx-room-head{display:flex;align-items:flex-start;justify-content:space-between;}
.qxx-room-title{font-size:32rpx;font-weight:700;color:#1A1A1A;}
.qxx-room-type{font-size:26rpx;color:var(--main-color);font-weight:600;}
.qxx-room-status{font-size:26rpx;font-weight:600;display:flex;flex-direction:column;align-items:flex-end;}
.qxx-room-status.st1{color:#47BA91;}
.qxx-room-status.st2{color:#1677FF;}
.qxx-room-status.st3{color:#FF8A4D;}
.qxx-room-status.st4{color:#FFAA00;}
.qxx-room-status.st0{color:#B0B4BB;}
.qxx-room-end{font-size:22rpx;font-weight:400;color:#FF8A4D;margin-top:6rpx;}
.qxx-room-tags{display:flex;flex-wrap:wrap;margin-top:18rpx;}
.qxx-tag{font-size:22rpx;color:#5A5E66;background:#F4F5F7;border-radius:10rpx;padding:6rpx 14rpx;margin:0 12rpx 10rpx 0;}
.qxx-room-mid{display:flex;align-items:baseline;justify-content:space-between;margin-top:10rpx;}
.qxx-room-price{font-size:38rpx;font-weight:700;color:var(--text-price);}
.qxx-price-unit{font-size:22rpx;color:#8A8F98;font-weight:400;}
.qxx-room-sub{font-size:22rpx;color:var(--main-color);}
.qxx-room-foot{display:flex;align-items:center;margin-top:20rpx;}
.qxx-times{flex:1;display:flex;flex-wrap:wrap;}
.qxx-time{width:48rpx;height:40rpx;line-height:40rpx;text-align:center;font-size:20rpx;color:#3A3D42;background:#F4F5F7;border-radius:8rpx;margin:0 4rpx 6rpx 0;}
.qxx-time.off{color:#C4C8CE;background:#F0F1F3;text-decoration:line-through;}
.qxx-book{width:120rpx;height:64rpx;line-height:64rpx;text-align:center;background:var(--main-gradient);color:#fff;font-size:26rpx;font-weight:600;border-radius:32rpx;margin-left:16rpx;flex-shrink:0;}
.qxx-book-dis{background:#E8EAED;color:#B0B4BB;}

.qxx-empty{text-align:center;color:#8A8F98;font-size:26rpx;padding:80rpx 0;}

.qxx-env{background:#fff;border-radius:24rpx;margin:8rpx 32rpx 0;padding:30rpx 32rpx;}
.qxx-env-title{font-size:30rpx;font-weight:700;color:#1A1A1A;margin-bottom:20rpx;}
.qxx-env-img{width:50%;margin:0 auto 16rpx;display:block;border-radius:16rpx;}

.qxx-footer{text-align:center;font-size:22rpx;color:#B0B4BB;margin-top:32rpx;}

.qxx-env-sub{font-size:24rpx;color:#8A8F98;margin-bottom:20rpx;}
