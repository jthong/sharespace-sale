}

.reserve-box {
  width: 539rpx;
  background: linear-gradient(180deg, #E0F5ED 0%, #FFFFFF 16%, #FFFFFF 100%);
  border-radius: var(--radius-lg);
  margin: 0 auto;
  padding: 34rpx 40rpx;
}

.reserve-box .title {
  font-weight: 600;
  font-size: 36rpx;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 48rpx;
}

.reserve-box .time-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 34rpx;
}

.reserve-box .time-line .dot {
  width: 12rpx;
  height: 12rpx;
  background: #FF8A4D;
  border-radius: 50%;
  position: relative;
  z-index: 9;
}

.reserve-box .time-line .dot::before {
  content: '';
  height: 60px;
  width: 2rpx;
  background: #FF8A4D;
  left: calc(50% - 2rpx);
  top: -50rpx;
  position: absolute;
  z-index: -1;
}

.reserve-box .time-line .time-tag {
  color: #fff;
  background-color: #FF8A4D;
  width: 414rpx;
  height: 46rpx;
  border-radius: 17rpx;
  line-height: 46rpx;
  display: flex;
  justify-content: space-between;
  font-weight: 400;
  font-size: 24rpx;
  color: #FFFFFF;
  padding: 9rpx 22rpx;
  position: relative;
}

.reserve-box .time-line .time-tag::before {
  content: '';
  width: 0;
  height: 0;
  border-bottom: 15rpx solid transparent;
  border-top: 15rpx solid transparent;
  border-right: 15rpx solid #FF8A4D;
  border-left: 15rpx solid transparent;
  left: -29rpx;
  top: calc(50% - 15rpx);
  position: absolute;
  z-index: 3;
}

.reserve-box button {
  width: 208rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: var(--main-gradient);
  border-radius: var(--radius-full);
  font-weight: 500;
  font-size: 26rpx;
  color: #FFFFFF;
  margin-top: 22rpx;
  box-shadow: var(--shadow-button);
}

/* 台球css */
.tab-container {
  display: flex;
  flex-wrap: wrap;
}

.tab-item {
  width: 44%;
  display: flex;
  flex-direction: column;
  margin: auto 20rpx;
}

.tab-left {
  width: 100%;
  height: 226rpx;
  /* border: 1rpx solid #eee; */
  border-radius: 10rpx;
  /* background-color: #fff; */
  padding: 0;
  box-sizing: border-box;
}

.tab-left-top {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-img-box-begin {
  width: 100%;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  color: #fff;
  /* flex-wrap: wrap; */
  background-size: contain;
  background-repeat: no-repeat; 
  background-position: center;   /* 背景图像居中 */
