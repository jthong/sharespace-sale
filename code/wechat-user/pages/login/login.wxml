<!--pages/login/login.wxml-->
<view class="login-page">
  <view class="login-bg">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
  </view>

  <view class="login-content">
    <view class="brand-section">
      <view class="brand-logo">
        <image lazy-load src="{{userinfo.avatar?userinfo.avatar:'https://oss.systemdiv.com/775b494fdf70e3a9063a0a570a2827a843e0c0c0930229f9ce15a486b80114d4.png'}}" mode="aspectFill" />
      </view>
      <view class="brand-name">{{appName}}</view>
      <view class="brand-desc">欢迎使用，请登录您的账号</view>
    </view>

    <block wx:if="{{fastLogin}}">
      <view class="action-section">
        <button class="btn-primary-action" hover-class="btn-hover" bindgetphonenumber="phone" open-type="getPhoneNumber">
          一键手机号登录
        </button>

        <block wx:if="{{mobile}}">
          <view class="auto-login-box" bind:tap="autoLogin">
            <view class="auto-label">检测到已注册账号</view>
            <view class="auto-phone">{{mobile}}</view>
            <view class="auto-hint">点击自动登录</view>
          </view>
        </block>

        <view class="back-link" bind:tap="backHome">返回首页</view>
      </view>
    </block>

    <block wx:else>
      <view class="pwd-section">
        <view class="input-group">
          <view class="input-label">手机号</view>
          <input class="input-field" model:value="{{username}}" type="number" placeholder="请输入11位手机号" maxlength="11" />
        </view>
        <view class="input-group">
          <view class="input-label">密码</view>
          <input class="input-field" model:value="{{password}}" type="password" placeholder="请输入8-16位密码" maxlength="16" />
        </view>

        <view class="pwd-actions">
          <view class="btn-login" hover-class="btn-hover" bind:tap="userLogin">登 录</view>
          <view class="link-wx" bind:tap="wxLogin">微信一键登录</view>
        </view>
      </view>
    </block>

    <view class="agreement-section">
      <view class="agreement-row" bind:tap="toggleAgreement">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}">✓</text>
        </view>
        <view class="agreement-text">
          我已阅读并同意
          <text class="agreement-link" catch:tap="openUserAgreement">《用户协议》</text>
          和
          <text class="agreement-link" catch:tap="openPrivacyPolicy">《隐私政策》</text>
        </view>
      </view>
    </view>
  </view>
</view>
