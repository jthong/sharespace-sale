/* pages/login/login.wxss */

page {
  background: #fff;
}

.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ---- background decoration ---- */
.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  background: var(--main-gradient);
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.bg-circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -80rpx;
}

.bg-circle-2 {
  width: 260rpx;
  height: 260rpx;
  top: 200rpx;
  left: -60rpx;
}

/* ---- content ---- */
.login-content {
  position: relative;
  z-index: 1;
  padding: 0 60rpx;
}

/* ---- brand ---- */
.brand-section {
  padding-top: 160rpx;
  text-align: center;
}

.brand-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.brand-logo image {
  width: 100%;
  height: 100%;
}

.brand-name {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.brand-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---- action section (fast login) ---- */
.action-section {
  margin-top: 80rpx;
}

.btn-primary-action {
  width: 100% !important;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--main-gradient);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-button);
  border: none;
  letter-spacing: 2rpx;
}

.btn-primary-action::after {
  display: none;
}

.auto-login-box {
  margin-top: 40rpx;
  padding: 30rpx;
  background: var(--bg-section);
  border-radius: var(--radius-md);
  text-align: center;
}

.auto-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.auto-phone {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

.auto-hint {
  font-size: 24rpx;
  color: var(--main-color);
  margin-top: 12rpx;
}

.back-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ---- password login ---- */
.pwd-section {
  margin-top: 60rpx;
  padding: 50rpx 40rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-elevated);
}

.input-group {
  margin-bottom: 36rpx;
}

.input-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border-bottom: 2rpx solid var(--border-medium);
  padding: 0 8rpx;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input-field:focus {
  border-bottom-color: var(--main-color);
}

.pwd-actions {
  margin-top: 50rpx;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: var(--main-gradient);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-button);
  letter-spacing: 4rpx;
}

.link-wx {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* ---- hover ---- */
.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ---- agreement ---- */
.agreement-section {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  padding: 0 60rpx;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.checkbox.checked {
  background: #47BA91;
  border-color: #47BA91;
}

.agreement-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

.agreement-link {
  color: var(--main-color);
}
