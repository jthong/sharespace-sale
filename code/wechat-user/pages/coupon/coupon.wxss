/* pages/coupon/coupon.wxss */

page {
  background-color: var(--bg-page);
  background-image: repeating-linear-gradient(
    45deg,
    rgba(71, 186, 145, 0.03) 0px,
    rgba(71, 186, 145, 0.03) 16px,
    transparent 16px,
    transparent 32px
  );
}

.coupon-page {
  padding-top: 100rpx;
}

/* ---- tabs ---- */
.tabs-bar {
  position: fixed;
  z-index: 9;
  top: 0;
  left: 0;
  width: 100%;
  height: 88rpx;
  background: var(--bg-card);
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  position: relative;
  padding: 0 30rpx;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: color 0.2s;
}

.tab-item.active .tab-text {
  color: var(--main-color);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--main-color);
}

/* ---- no-use card ---- */
.no-use-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.no-use-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-active {
  border-color: var(--main-color);
}

.radio-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--main-color);
}

/* ---- coupon card ---- */
.coupon-list {
  padding: 24rpx 30rpx;
}

.coupon-card {
  display: flex;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 24rpx;
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  position: relative;
}

.coupon-disabled {
  opacity: 0.65;
}

/* ---- left value area ---- */
.coupon-left {
  width: 200rpx;
  min-height: 220rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.coupon-left-time {
  background: var(--main-color-light);
}

.coupon-left-money {
  background: linear-gradient(135deg, #E8F7F2, #E0F5ED);
}

.coupon-left::after {
  content: "";
  position: absolute;
  right: 0;
  top: 10%;
  height: 80%;
  width: 2rpx;
  background: repeating-linear-gradient(
    to bottom,
    var(--border-light) 0,
    var(--border-light) 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
}

.coupon-left-inner {
  text-align: center;
  padding: 20rpx;
}

.coupon-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--main-color);
  line-height: 1.2;
}

.coupon-symbol {
  font-size: 28rpx;
}

.coupon-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

.coupon-condition {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* ---- right detail area ---- */
.coupon-right {
  flex: 1;
  padding: 24rpx 30rpx;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-detail {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-detail-label {
  color: var(--text-secondary);
  margin-right: 12rpx;
  font-size: 24rpx;
}

/* ---- overlay tip ---- */
.overlay-tip {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 2;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.overlay-box {
  text-align: center;
}

.overlay-label {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

/* ---- empty state ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  opacity: 0.6;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-tertiary);
}
