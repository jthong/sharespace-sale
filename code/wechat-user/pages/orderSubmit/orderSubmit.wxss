/* pages/orderSubmit/orderSubmit.wxss - 雀小仙交互版 */
page {
  background: #F5F6F8;
}
.page-wrap {
  padding-bottom: 140rpx;
}

/* ===== 顶部房间大图 ===== */
.hero {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
}
.hero-img {
  width: 100%;
  height: 100%;
}
.hero-mask {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 160rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3), transparent);
}
.back-btn {
  position: absolute;
  top: 90rpx;
  left: 30rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-text {
  color: #fff;
  font-size: 44rpx;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== 白色信息卡片 ===== */
.info-card {
  margin: -50rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.room-title-row {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.room-icon {
  margin-right: 12rpx;
}
.room-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}
.room-type {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 日期 */
.date-scroll {
  white-space: nowrap;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.date-row {
  display: inline-flex;
  gap: 20rpx;
}
.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
}
.date-item.active .date-num {
  color: #222;
  font-weight: 700;
}
.date-item.active .date-week {
  color: #47BA91;
  font-weight: 600;
}
.date-item.active {
  position: relative;
}
.date-item.active::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #47BA91;
  border-radius: 3rpx;
}
.date-num {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.date-week {
  font-size: 24rpx;
  color: #999;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}
.form-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  width: 140rpx;
  flex-shrink: 0;
}
.duration-scroll {
  flex: 1;
  white-space: nowrap;
}
.duration-list {
  display: flex;
  gap: 16rpx;
}
.duration-chip {
  padding: 12rpx 28rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
}
.duration-chip.active {
  border-color: #47BA91;
  color: #47BA91;
  font-weight: 600;
  background: rgba(71,186,145,0.05);
}

/* 时间选择 */
.time-picker-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}
.time-picker {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}
.time-picker.disabled {
  background: #f5f5f5;
  color: #999;
}
.dropdown {
  font-size: 22rpx;
  color: #999;
  margin-left: 10rpx;
}
.time-dash {
  color: #999;
  font-size: 28rpx;
}

/* ===== 时间格子卡片 ===== */
.grid-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}
.meituan-banner {
  display: flex;
  align-items: center;
  background: #FFE84D;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}
.mt-badge {
  background: #FFD100;
  color: #333;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.mt-text {
  font-size: 24rpx;
  color: #333;
}
.legend-row {
  display: flex;
  justify-content: flex-end;
  gap: 30rpx;
  margin-bottom: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}
.legend-box {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}
.legend-busy { background: #FB8C6A; }
.legend-free { background: #47BA91; }

.time-grid {
  display: flex;
  gap: 8rpx;
}
.grid-cell {
  flex: 1;
  height: 48rpx;
  border-radius: 8rpx;
}
.cell-free { background: #47BA91; }
.cell-busy { background: #E8E8E8; }
.grid-scale {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}
.scale-text {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #aaa;
}
.next-day-label {
  font-size: 28rpx;
  color: #999;
  margin: 24rpx 0 16rpx;
}

/* ===== 支付信息卡片 ===== */
.pay-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 30rpx;
}
.pay-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.pay-row:last-child { border-bottom: none; }
.pay-left {
  display: flex;
  align-items: center;
}
.pay-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
}
.icon-balance { background: #47BA91; }
.icon-coupon { background: #FF9F43; }
.pay-label {
  font-size: 28rpx;
  color: #333;
}
.pay-right {
  display: flex;
  align-items: center;
}
.pay-action {
  font-size: 26rpx;
  color: #999;
}
.pay-action.placeholder { color: #bbb; }
.arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 10rpx;
}
.coupon-input {
  font-size: 26rpx;
  color: #333;
  margin-right: 16rpx;
}
.paste-btn {
  background: #47BA91;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}
.tg-icons {
  display: flex;
  gap: 8rpx;
  margin-right: 16rpx;
}
.tg-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}
.tg-meituan { background: #FFD100; color: #333; }
.tg-douyin { background: #000; }

/* ===== 底部固定支付栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.bottom-price {
  display: flex;
  align-items: baseline;
}
.price-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
}
.price-tip {
  font-size: 24rpx;
  color: #FB8C6A;
  margin-left: 12rpx;
}
.bottom-btns {
  display: flex;
  gap: 16rpx;
}
.pay-btn {
  border-radius: 44rpx;
  text-align: center;
}
.btn-wechat {
  background: #47BA91;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 50rpx;
}
.btn-balance {
  background: #fff;
  border: 2rpx solid #47BA91;
  color: #47BA91;
  padding: 10rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.btn-balance .btn-main {
  font-size: 28rpx;
  font-weight: 600;
}
.btn-balance .btn-sub {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ===== 保留弹窗样式 ===== */
.color-attention { color: #FF4444; }
.reserve-box { padding: 40rpx; }
.reserve-box .title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 30rpx; }
.time-line { display: flex; align-items: center; padding: 16rpx 0; }
.time-line .dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #47BA91; margin-right: 20rpx; }
.time-tag { font-size: 28rpx; color: #333; }

/* 时间选择弹窗 */
.timeSelect .top { padding: 30rpx; }
.timeSelect .title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 20rpx; }
.timeSelect .time-slot { display: flex; gap: 20rpx; }
.timeSelect .time-slot view { padding: 12rpx 24rpx; border-radius: 12rpx; font-size: 26rpx; color: #666; }
.timeSelect .time-slot .active { background: #47BA91; color: #fff; }
.timeSelect .timeOutlet { height: 800rpx; }
.timeSelect .timeOutlet .item { padding: 24rpx 30rpx; border-bottom: 1rpx solid #f0f0f0; }
.timeSelect .timeOutlet .time { font-size: 30rpx; color: #333; }
.timeSelect .timeOutlet .available { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.timeSelect .timeOutlet .item.enable { color: #47BA91; }

/* 优惠券弹窗 */
.popup .title { font-size: 34rpx; font-weight: 700; text-align: center; padding: 30rpx 0 10rpx; }
.couponList { padding: 20rpx 30rpx; }
.couponItem { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; }
.couponItem .top { display: flex; padding: 24rpx; }
.couponItem .c1 { width: 180rpx; border-right: 1rpx dashed #eee; padding-right: 20rpx; }
.couponItem .price { font-size: 36rpx; font-weight: 700; color: #FF4444; }
.couponItem .type { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.couponItem .desc { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }
.couponItem .c2 { flex: 1; padding-left: 20rpx; }
.couponItem .item-name { font-size: 28rpx; color: #333; font-weight: 500; }
.couponItem .item-date { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.couponItem .c3 { display: flex; align-items: center; }
.couponItem .no { font-size: 22rpx; color: #bbb; margin-right: 16rpx; }
.radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #ddd; }
.radio.selected { border-color: #47BA91; background: #47BA91; box-shadow: inset 0 0 0 6rpx #fff; }

/* 团购弹窗 */
.tuangouBg { padding: 20rpx 30rpx; }
.tuangouBg .img { width: 100%; border-radius: 12rpx; }
.tgScan { display: flex; align-items: center; margin: 0 30rpx; padding: 20rpx; background: #f5f5f5; border-radius: 12rpx; }
.tgScan .input { flex: 1; font-size: 28rpx; }
.tgTitle { text-align: center; font-size: 28rpx; color: #333; padding: 20rpx; }
.timer { display: flex; align-items: center; justify-content: center; padding: 20rpx; gap: 16rpx; }
.timer .title { font-size: 28rpx; color: #666; }
.timer .time { padding: 10rpx 20rpx; border: 2rpx solid #e5e5e5; border-radius: 10rpx; font-size: 26rpx; }
.timer .time.active { border-color: #47BA91; color: #47BA91; }
.timer .divide { color: #999; }
.order-bar { background: #fff; padding: 20rpx 30rpx; display: flex; justify-content: space-between; align-items: center; }
.order-bar .total { font-size: 36rpx; font-weight: 700; }
.order-bar .btn { background: #47BA91; color: #fff; font-size: 28rpx; padding: 16rpx 40rpx; border-radius: 40rpx; }
