<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudsteward.module.member.dal.mysql.couponactive.CouponActiveMapper">

    <!--
        一般情况下，尽可能使用 Mapper 进行 CRUD 增删改查即可。
        无法满足的场景，例如说多表关联查询，才使用 XML 编写 SQL。
        代码生成器暂时只生成 Mapper XML 文件本身，更多推荐 MybatisX 快速开发插件来生成查询。
        文档可见：https://www.iocoder.cn/MyBatis/x-plugins/
     -->

    <select id="getAdminByCouponId"
            resultType="com.cloudsteward.module.member.controller.app.coupon.vo.AppCouponActiveRespVO">
        select *
        from member_coupon_active
        where deleted = 0
          and coupon_id = #{couponId}
    </select>
    <select id="getByCouponId" resultType="com.cloudsteward.module.member.dal.dataobject.couponactive.CouponActiveDO">
        select *
        from member_coupon_active
        where deleted = 0
          and coupon_id = #{couponId}
    </select>
    <select id="getByInfoId"
            resultType="com.cloudsteward.module.member.controller.app.coupon.vo.AppCouponActiveInfoRespVO">
        select ac.*,
               c.*,
               s.store_name
        from member_coupon_active ac
                 left join member_coupon_info c ON ac.coupon_id = c.coupon_id
                 left join member_store_info s ON ac.store_id = s.store_id
        where ac.deleted = 0
          and ac.coupon_id = #{id}
    </select>
</mapper>
