server:
  port: 48080
spring:
  datasource:
    dynamic:
      primary: master
      datasource:
        master:
          url: ${SHARESPACE_DB_URL:jdbc:mysql://localhost:3306/sharespace?serverTimezone=Asia/Shanghai&characterEncoding=UTF-8}
          username: ${SHARESPACE_DB_USER}
          password: ${SHARESPACE_DB_PASSWORD}
  redis:
    host: ${SHARESPACE_REDIS_HOST:localhost}
    port: ${SHARESPACE_REDIS_PORT:6379}
    password: ${SHARESPACE_REDIS_PASSWORD:}
